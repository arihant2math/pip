{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@number0/iroh": [
        "./pi-live/node_modules/@number0/iroh/index.d.ts"
      ]
    },
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "codemode/*.ts",
    "codemode/tests/*.ts",
    "subagents/*.ts",
    "pi-live/*.ts",
    "gemini-priority/*.ts"
  ]
}
